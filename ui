local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local COLORS = {
    Background = Color3.fromRGB(13, 13, 18),
    Panel = Color3.fromRGB(17, 17, 23),
    Panel2 = Color3.fromRGB(21, 21, 29),
    Stroke = Color3.fromRGB(43, 40, 55),
    Text = Color3.fromRGB(224, 222, 232),
    Muted = Color3.fromRGB(139, 136, 151),
    Accent = Color3.fromRGB(177, 91, 255),
    Accent2 = Color3.fromRGB(133, 72, 218),
    Off = Color3.fromRGB(48, 47, 57),
}

local function create(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return create("UICorner", {CornerRadius = UDim.new(0, radius or 4)}, parent)
end

local function stroke(parent, color, transparency)
    return create("UIStroke", {
        Color = color or COLORS.Stroke,
        Transparency = transparency or 0,
        Thickness = 1,
    }, parent)
end

local function label(parent, text, size, color, font)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color or COLORS.Text,
        TextSize = size or 14,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0),
    }, parent)
end

local function callback(fn, value)
    if type(fn) == "function" then
        task.spawn(function()
            local ok, err = pcall(fn, value)
            if not ok then warn("[ScriptUI] " .. tostring(err)) end
        end)
    end
end

function Library.new(config)
    config = config or {}
    local self = setmetatable({}, Library)
    self.Tabs = {}
    self.ActiveTab = nil
    self.Title = config.Title or "script ui"
    self.Subtitle = config.Subtitle or "discord.gg/example"
    self.Size = config.Size or UDim2.fromOffset(760, 590)

    local guiParent
    if type(gethui) == "function" then
        local ok, result = pcall(gethui)
        if ok then guiParent = result end
    end
    guiParent = guiParent or CoreGui

    local gui = create("ScreenGui", {
        Name = config.Name or "ScriptUILibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
    }, guiParent)
    self.Gui = gui

    local main = create("Frame", {
        Name = "Main",
        Size = self.Size,
        Position = UDim2.new(0.5, -self.Size.X.Offset / 2, 0.5, -self.Size.Y.Offset / 2),
        BackgroundColor3 = COLORS.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, gui)
    corner(main, 5)
    stroke(main, Color3.fromRGB(53, 48, 68))
    self.Main = main

    local top = create("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 31),
        BackgroundColor3 = Color3.fromRGB(11, 11, 15),
        BorderSizePixel = 0,
    }, main)
    local title = label(top, self.Title .. "  -  " .. self.Subtitle, 12, COLORS.Muted, Enum.Font.GothamMedium)
    title.Position = UDim2.fromOffset(12, 0)
    title.Size = UDim2.new(0.7, 0, 1, 0)
    local right = label(top, config.Version or "v1.0", 12, COLORS.Muted)
    right.TextXAlignment = Enum.TextXAlignment.Right
    right.Position = UDim2.new(0.75, 0, 0, 0)
    right.Size = UDim2.new(0.22, -10, 1, 0)

    local tabsBar = create("Frame", {
        Name = "Tabs",
        Position = UDim2.fromOffset(12, 35),
        Size = UDim2.new(1, -24, 0, 39),
        BackgroundTransparency = 1,
    }, main)
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 17),
    }, tabsBar)
    self.TabsBar = tabsBar

    local underline = create("Frame", {
        Name = "TabUnderline",
        Size = UDim2.fromOffset(72, 3),
        Position = UDim2.fromOffset(0, 35),
        BackgroundColor3 = COLORS.Accent,
        BorderSizePixel = 0,
    }, tabsBar)
    self.Underline = underline

    local content = create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(12, 78),
        Size = UDim2.new(1, -24, 1, -90),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, main)
    self.Content = content

    -- Dragging from the header area.
    local dragging, dragStart, startPos = false, nil, nil
    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, main.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return self
end

function Library:CreateTab(name)
    local tab = {Name = name, Sections = {}}
    local button = create("TextButton", {
        Name = name .. "Tab",
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = COLORS.Muted,
        TextSize = 15,
        Font = Enum.Font.GothamMedium,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, 34),
    }, self.TabsBar)
    tab.Button = button
    tab.Page = create("Frame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
    }, self.Content)

    local columns = create("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, tab.Page)
    tab.Columns = {}
    for i = 1, 2 do
        local col = create("ScrollingFrame", {
            Name = "Column" .. i,
            Position = UDim2.new((i - 1) * 0.5, i == 1 and 0 or 7, 0, 0),
            Size = UDim2.new(0.5, -7, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = COLORS.Accent,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
        }, columns)
        create("UIListLayout", {
            Padding = UDim.new(0, 9),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, col)
        tab.Columns[i] = col
    end

    button.MouseButton1Click:Connect(function() self:SelectTab(name) end)
    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(name) end
    return tab
end

function Library:SelectTab(name)
    for _, tab in ipairs(self.Tabs) do
        local selected = tab.Name == name
        tab.Page.Visible = selected
        tab.Button.TextColor3 = selected and COLORS.Text or COLORS.Muted
        if selected then
            self.ActiveTab = tab
            TweenService:Create(self.Underline, TweenInfo.new(0.18), {
                Position = UDim2.new(0, tab.Button.AbsolutePosition.X - self.TabsBar.AbsolutePosition.X, 0, 35),
                Size = UDim2.fromOffset(math.max(48, tab.Button.AbsoluteSize.X), 3),
            }):Play()
        end
    end
end

function Library:CreateSection(tab, name, column)
    assert(tab and tab.Columns, "CreateSection expects a tab returned by CreateTab")
    column = column or 1
    local section = {Name = name}
    local frame = create("Frame", {
        Name = name:gsub("%s+", "") .. "Section",
        Size = UDim2.new(1, -3, 0, 40),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = COLORS.Panel,
        BorderSizePixel = 0,
    }, tab.Columns[column])
    corner(frame, 3)
    stroke(frame, COLORS.Stroke)
    local heading = label(frame, name, 16, COLORS.Text, Enum.Font.GothamMedium)
    heading.Position = UDim2.fromOffset(12, 2)
    heading.Size = UDim2.new(1, -24, 0, 27)
    local body = create("Frame", {
        Name = "Controls",
        Position = UDim2.fromOffset(10, 31),
        Size = UDim2.new(1, -20, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, frame)
    create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, body)
    create("UIPadding", {PaddingBottom = UDim.new(0, 10)}, body)
    section.Frame, section.Body = frame, body

    local function row(height)
        return create("Frame", {
            Size = UDim2.new(1, 0, 0, height or 25),
            BackgroundTransparency = 1,
        }, body)
    end

    function section:AddLabel(text)
        local r = row(22)
        local t = label(r, text, 13, COLORS.Muted)
        t.Position = UDim2.fromOffset(2, 0)
        return t
    end

    function section:AddToggle(text, default, changed)
        local r = row(25)
        local box = create("TextButton", {
            Size = UDim2.fromOffset(17, 17),
            Position = UDim2.fromOffset(2, 4),
            Text = "",
            BackgroundColor3 = default and COLORS.Accent or COLORS.Panel2,
            BorderSizePixel = 0,
            AutoButtonColor = false,
        }, r)
        corner(box, 2)
        stroke(box, COLORS.Stroke)
        local tick = create("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = default and "✓" or "", TextColor3 = Color3.new(1, 1, 1),
            TextSize = 12, Font = Enum.Font.GothamBold,
        }, box)
        local txt = label(r, text, 14, COLORS.Text)
        txt.Position = UDim2.fromOffset(27, 0)
        txt.Size = UDim2.new(1, -29, 1, 0)
        local value = default == true
        local control = {}
        function control:Set(v)
            value = v == true
            box.BackgroundColor3 = value and COLORS.Accent or COLORS.Panel2
            tick.Text = value and "✓" or ""
            callback(changed, value)
        end
        function control:Get() return value end
        box.MouseButton1Click:Connect(function() control:Set(not value) end)
        return control
    end

    function section:AddSlider(text, min, max, default, suffix, changed)
        local r = row(48)
        local topLine = label(r, text, 14, COLORS.Text)
        topLine.Position = UDim2.fromOffset(2, 0)
        topLine.Size = UDim2.new(0.72, 0, 0, 21)
        local valueText = label(r, "", 13, COLORS.Text)
        valueText.TextXAlignment = Enum.TextXAlignment.Right
        valueText.Position = UDim2.new(0.7, 0, 0, 0)
        valueText.Size = UDim2.new(0.3, -2, 0, 21)
        local bar = create("Frame", {
            Position = UDim2.fromOffset(2, 29),
            Size = UDim2.new(1, -4, 0, 7),
            BackgroundColor3 = COLORS.Off,
            BorderSizePixel = 0,
        }, r)
        corner(bar, 2)
        local fill = create("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = COLORS.Accent, BorderSizePixel = 0}, bar)
        corner(fill, 2)
        local knob = create("Frame", {
            Size = UDim2.fromOffset(9, 13), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(238, 228, 255),
            BorderSizePixel = 0,
        }, bar)
        corner(knob, 2)
        local value = math.clamp(default or min, min, max)
        local control = {}
        local function set(v, fire)
            value = math.clamp(v, min, max)
            local alpha = max == min and 0 or (value - min) / (max - min)
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
            valueText.Text = tostring(value) .. (suffix or "")
            if fire then callback(changed, value) end
        end
        function control:Set(v) set(v, true) end
        function control:Get() return value end
        local sliding = false
        local function update(input)
            local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            set(min + (max - min) * alpha, true)
        end
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true; update(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
        end)
        set(value, false)
        return control
    end

    function section:AddDropdown(text, options, default, changed)
        local r = row(49)
        local caption = label(r, text, 14, COLORS.Text)
        caption.Position = UDim2.fromOffset(2, 0)
        caption.Size = UDim2.new(1, -4, 0, 19)
        local btn = create("TextButton", {
            Position = UDim2.fromOffset(2, 22),
            Size = UDim2.new(1, -4, 0, 25),
            BackgroundColor3 = COLORS.Panel2,
            Text = "",
            BorderSizePixel = 0,
            AutoButtonColor = false,
        }, r)
        corner(btn, 2); stroke(btn, COLORS.Stroke)
        local current = default or options[1] or "None"
        local valueLabel = label(btn, tostring(current), 13, COLORS.Text)
        valueLabel.Position = UDim2.fromOffset(9, 0)
        valueLabel.Size = UDim2.new(1, -28, 1, 0)
        local arrow = label(btn, "⌄", 15, COLORS.Muted)
        arrow.TextXAlignment = Enum.TextXAlignment.Right
        arrow.Position = UDim2.new(1, -23, 0, 0)
        arrow.Size = UDim2.fromOffset(15, 25)
        local popup
        local control = {}
        function control:Get() return current end
        function control:Set(v)
            if table.find(options, v) then
                current = v; valueLabel.Text = tostring(v); callback(changed, v)
            end
        end
        btn.MouseButton1Click:Connect(function()
            if popup then popup:Destroy(); popup = nil; return end
            popup = create("Frame", {
                Position = UDim2.new(0, 0, 1, 3),
                Size = UDim2.new(1, 0, 0, math.min(#options * 25, 125)),
                BackgroundColor3 = COLORS.Panel2,
                BorderSizePixel = 0,
                ZIndex = 20,
            }, btn)
            corner(popup, 3); stroke(popup, COLORS.Stroke)
            local list = create("ScrollingFrame", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                BorderSizePixel = 0, ScrollBarThickness = 2,
                CanvasSize = UDim2.new(0, 0, 0, #options * 25),
                ZIndex = 21,
            }, popup)
            create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
            for _, option in ipairs(options) do
                local choice = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 25), BackgroundTransparency = 1,
                    Text = tostring(option), TextColor3 = COLORS.Text,
                    TextSize = 13, Font = Enum.Font.Gotham,
                    ZIndex = 22,
                }, list)
                choice.MouseButton1Click:Connect(function()
                    control:Set(option); popup:Destroy(); popup = nil
                end)
            end
        end)
        return control
    end

    function section:AddButton(text, pressed)
        local r = row(27)
        local btn = create("TextButton", {
            Position = UDim2.fromOffset(2, 0),
            Size = UDim2.new(1, -4, 1, 0),
            BackgroundColor3 = COLORS.Panel2,
            Text = text,
            TextColor3 = COLORS.Text,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            BorderSizePixel = 0,
            AutoButtonColor = true,
        }, r)
        corner(btn, 2); stroke(btn, COLORS.Stroke)
        btn.MouseButton1Click:Connect(function() callback(pressed) end)
        return btn
    end

    table.insert(tab.Sections, section)
    return section
end

function Library:Destroy()
    if self.Gui then self.Gui:Destroy() end
end

return Library
